<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Vyaya.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Vyaya.Views"
    Title="Vyaya"
    FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Home" Icon="dotnet_bot.png" Route="home">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" Route="homePage" />
        </Tab>

        <Tab Title="Scan &amp; Pay" Icon="dotnet_bot.png" Route="scan">
            <ShellContent ContentTemplate="{DataTemplate views:ScanPage}" Route="scanPage" />
        </Tab>

        <Tab Title="History" Icon="dotnet_bot.png" Route="expenses">
            <ShellContent ContentTemplate="{DataTemplate views:ExpensesPage}" Route="expensesPage" />
        </Tab>

        <Tab Title="Analytics" Icon="dotnet_bot.png" Route="analytics">
            <ShellContent ContentTemplate="{DataTemplate views:MonthlySummaryPage}" Route="monthlySummaryPage" />
        </Tab>

        <Tab Title="Settings" Icon="dotnet_bot.png" Route="settings">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="settingsPage" />
        </Tab>
    </TabBar>

</Shell>
