<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyaya.ViewModels"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="Vyaya.Views.ScanPage"
             x:DataType="vm:ScanViewModel"
             Title="Scan &amp; Pay"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="*,Auto" Padding="14,8,14,14">

        <!-- Live Camera Viewfinder Card -->
        <Border Stroke="{StaticResource CardBorder}"
                StrokeShape="RoundRectangle 22"
                BackgroundColor="#000000"
                Padding="0"
                Margin="0,0,0,10"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">

            <Grid>
                <!-- Native Camera Barcode Reader View -->
                <zxing:CameraBarcodeReaderView
                    x:Name="BarcodeReaderView"
                    CameraLocation="Rear"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    IsDetecting="True"
                    IsTorchOn="{Binding IsTorchOn}"
                    BarcodesDetected="BarcodeReaderView_BarcodesDetected" />

                <!-- Overlay Reticle and Controls -->
                <Grid InputTransparent="True" Padding="16">
                    <!-- Top Bar with Instructions and Flash Button -->
                    <Grid VerticalOptions="Start" ColumnDefinitions="*,Auto" Margin="4,4">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Scan UPI QR Code"
                                   FontSize="16"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource White}"
                                   Shadow="{Shadow Radius=3, Brush=Black, Offset='0,1'}"/>
                            <Label Text="Align PhonePe / UPI QR in frame"
                                   FontSize="11"
                                   TextColor="{StaticResource Gray300}"
                                   Shadow="{Shadow Radius=3, Brush=Black, Offset='0,1'}"/>
                        </VerticalStackLayout>

                        <!-- Torch Button (Interactive) -->
                        <Border Grid.Column="1"
                                Stroke="{StaticResource CardBorder}"
                                StrokeShape="RoundRectangle 18"
                                BackgroundColor="#90000000"
                                Padding="12,6"
                                VerticalOptions="Center"
                                InputTransparent="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleTorchCommand}"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="🔦" FontSize="14" VerticalOptions="Center"/>
                                <Label Text="Flash" FontSize="12" TextColor="{StaticResource White}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Center QR Viewfinder Frame -->
                    <Border WidthRequest="240"
                            HeightRequest="240"
                            Stroke="{StaticResource IosBlue}"
                            StrokeThickness="3"
                            StrokeShape="RoundRectangle 26"
                            BackgroundColor="#100A84FF"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Grid>
                            <!-- Animated Horizontal Laser Scanner Line -->
                            <BoxView HeightRequest="2"
                                     Color="{StaticResource IosBlue}"
                                     VerticalOptions="Center"
                                     Margin="20,0"
                                     Opacity="0.9"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Error / Unsupported QR Message -->
                <Border IsVisible="{Binding HasError}"
                        Stroke="#FF453A"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#E5000000"
                        Padding="14,10"
                        VerticalOptions="End"
                        Margin="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Text="⚠️" FontSize="18" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="12" TextColor="#FF453A" LineBreakMode="WordWrap" VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Fallback & Manual UPI String Input -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Border Stroke="{StaticResource CardBorder}"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource CardBackground}"
                    Padding="12,10">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Text="MANUAL UPI / CLIPBOARD PASTE"
                               FontSize="10"
                               CharacterSpacing="1"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource TextSecondary}"/>

                        <Label Grid.Column="1"
                               Text="Paste from Clipboard"
                               FontSize="11"
                               TextColor="{StaticResource IosBlue}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PasteFromClipboardCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Stroke="{StaticResource CardBorder}"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource InputBackground}"
                                Padding="10,0">
                            <Entry Placeholder="upi://pay?pa=... or 9876543210@ybl"
                                   Text="{Binding ManualQrPayload}"
                                   FontSize="12"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Button Grid.Column="1"
                                Text="Process"
                                HeightRequest="40"
                                FontSize="12"
                                BackgroundColor="{StaticResource IosBlue}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10"
                                Command="{Binding SubmitManualPayloadCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
